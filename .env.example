# PicBox 配置模板。复制为部署环境文件（例如 /etc/picbox.env）后按需修改，
# 不要把真实密钥提交到 Git。所有项都可省略；省略即使用下面的默认值。
# 完整说明见 README.md。

# 监听地址：默认只绑环回。对外提供服务时显式设置为 0.0.0.0:3001 并配置真实 BASEURL。
PICBOX_ADDR=127.0.0.1:3001
# 数据目录（SQLite 数据库、auth.key、图片、暂存清理目录）。整体备份/恢复。
PICBOX_DATA_DIR=./data
# 对外访问的完整站点源地址，用于绝对链接、写请求来源校验和邮件链接。只支持域名根路径。
# 例如 https://image.example.com
BASEURL=

# 可信反向代理的 IP/CIDR（逗号分隔）。留空（默认）= 不信任任何转发头，只按直连对端
# 分桶：直接启动时正确，但经反代部署时所有客户端会共用一个限流桶（可用性退化）。
# 本机 Nginx 用 127.0.0.1/32,::1/128；代理必须设置 X-Forwarded-For $proxy_add_x_forwarded_for。
# 只列出实际代理地址，不要用 0.0.0.0/0 或整个内网段；非法值会在启动前报错。
TRUSTED_PROXIES=

# 上传与配额
UPLOAD_MAX_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
# 账号默认配额（字节）。0 = 不限；软删除图片仍计入。管理端可按账号覆盖。
USER_QUOTA_BYTES=0

# 导出成功冷却（小时）。0 表示关闭冷却；失败/取消的导出不消耗冷却。
EXPORT_COOLDOWN_HOURS=12
# 回收站保留天数，最小 1；超期由后台任务物理删除。
TRASH_RETENTION_DAYS=30

# 会话
AUTH_COOKIE_NAME=picbox_token
# 留空时按 BASEURL 是否为 https 自动决定；显式 true/false 可覆盖。
# COOKIE_SECURE=false
# 可选：至少 32 字节。留空时首次启动随机生成到 $PICBOX_DATA_DIR/auth.key（0600）。
# JWT_SECRET=

# 完全可选：找回密码与修改邮箱的外发邮件。SMTP_HOST 与 SMTP_FROM 都设置才算启用，
# 需要同时配置上面的 BASEURL；改完要重启服务才生效。
# 未启用时相关接口返回 503 MAIL_UNAVAILABLE，普通登录/上传/导出/管理端不受影响。
# 注册不需要邮件：首个账号免激活码，之后凭管理员生成的激活码。
# 程序不会自动读取本文件：它只是模板，变量必须由 shell/systemd/容器注入进程环境。
SMTP_HOST=
SMTP_PORT=587
# true = 连接即 TLS（通常 465）；false = STARTTLS（通常 587）。
SMTP_SECURE=false
# 默认 true：必须 STARTTLS 成功后才发送。只有显式设为 false 才接受明文投递；证书校验始终开启。
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址，例如 PicBox <no-reply@example.com>
SMTP_FROM=
