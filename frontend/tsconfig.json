{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "allowJs": false,
    // Only this package and the declaration files declared below. Nothing is
    // picked up from a parent directory's @types, so a clean checkout without
    // any extra `node_modules` still type-checks this bundle.
    "types": [],
    "paths": {
      "@/app/generated/prisma/enums": ["./src/shims/prisma-enums.ts"],
      "@/*": ["./*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"],
      "next/navigation": ["./src/shims/next-navigation.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
